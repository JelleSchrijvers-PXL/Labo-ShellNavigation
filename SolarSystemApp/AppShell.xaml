<?xml version="1.0" encoding="UTF-8" ?>
<Shell
	x:Class="SolarSystemApp.AppShell"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:pages="clr-namespace:SolarSystemApp.Pages"
	xmlns:local="clr-namespace:SolarSystemApp">
    <Shell.FlyoutHeader>
        <Grid Padding="30" BackgroundColor="{StaticResource Black}">
            <Image Source="moon_w.png"/>
        </Grid>
    </Shell.FlyoutHeader>
    <FlyoutItem Icon="moon_b.png" Title="Moon Phase">
        <ShellContent
			ContentTemplate="{DataTemplate pages:MoonPhasePage}"/>
    </FlyoutItem>
    
    <FlyoutItem Icon="sun.png" Title="Sunrise">
        <ShellContent
		ContentTemplate="{DataTemplate pages:SunrisePage}"/>
    </FlyoutItem>
    <FlyoutItem Icon="question.png" Title="About">
        <ShellContent
		ContentTemplate="{DataTemplate pages:AboutPage}"/>
    </FlyoutItem>
</Shell>
